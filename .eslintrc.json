{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    "no-restricted-syntax": [
      "error",
      {
        "selector": "Property[key.name='queryKey'][value.type='ArrayExpression']",
        "message": "Use a keys.ts factory (e.g. authKeys.me()) instead of an inline queryKey array."
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/features/**/*.ts", "src/features/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/*/*", "@/features/*/*/**"],
                "message": "Cross-slice imports go through the slice's barrel ('@/features/<slice>'). Same-slice imports are relative."
              }
            ]
          }
        ]
      }
    }
  ]
}
